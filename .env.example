# Meu Caixa — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o .env.local.

# --- banco ---
# Local (Podman, porta 5433). Em produção, use a string do POOLER do Neon.
DATABASE_URL=postgresql://financial:financial@localhost:5433/financial
# Conexão DIRETA (sem pooler). Usada só por drizzle-kit e pelos scripts de migration.
DATABASE_URL_UNPOOLED=postgresql://financial:financial@localhost:5433/financial

# --- acesso (login pelo Google, single-user) ---
# 32 bytes aleatórios. DIFERENTE por ambiente — assim um cookie de preview não abre produção.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
SESSION_MAX_AGE_DAYS=30

# Cliente OAuth criado em console.cloud.google.com/apis/credentials
# → Create Credentials → OAuth client ID → Web application.
# Em "Authorized redirect URIs", registre EXATAMENTE (uma linha por ambiente):
#   http://localhost:3005/api/auth/google/callback
#   https://SEU-DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A ÚNICA conta que entra. Qualquer outra é recusada no callback, mesmo tendo
# autenticado no Google com sucesso.
GOOGLE_ALLOWED_EMAIL=

# Base pública do app — monta o redirect_uri. Precisa bater com o registrado
# acima; divergir dá `redirect_uri_mismatch`, que falha fechado.
APP_URL=http://localhost:3005

# --- cron ---
# Só em produção. A Vercel injeta este valor como Bearer no header das rotas de cron.
CRON_SECRET=

# --- app ---
APP_TIMEZONE=America/Sao_Paulo
# UUID do único usuário. Preenchido pelo seed.
SINGLE_USER_ID=
