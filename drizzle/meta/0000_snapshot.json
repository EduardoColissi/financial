      "checkConstraints": {
        "tx_amount_ck": {
          "name": "tx_amount_ck",
          "value": "\"transactions\".\"amount_cents\" > 0 and \"transactions\".\"amount_cents\" < 2000000000"
        },
        "tx_competence_ck": {
          "name": "tx_competence_ck",
          "value": "extract(day from \"transactions\".\"competence_month\") = 1"
        },
        "tx_installment_ck": {
          "name": "tx_installment_ck",
          "value": "(\"transactions\".\"installment_seq\" is null) = (\"transactions\".\"installment_total\" is null)\n          and (\"transactions\".\"installment_seq\" is null or \"transactions\".\"installment_seq\" between 1 and \"transactions\".\"installment_total\")"
        },
        "tx_category_ck": {
          "name": "tx_category_ck",
          "value": "(\"transactions\".\"kind\" = 'transfer') = (\"transactions\".\"category_id\" is null)"
        },
        "tx_card_method_ck": {
          "name": "tx_card_method_ck",
          "value": "(\"transactions\".\"card_id\" is not null) = (\"transactions\".\"method\" = 'credit')"
        },
        "tx_target_ck": {
          "name": "tx_target_ck",
          "value": "case \"transactions\".\"kind\"\n            when 'expense'        then (\"transactions\".\"card_id\" is not null) <> (\"transactions\".\"account_id\" is not null)\n            when 'income'         then \"transactions\".\"account_id\" is not null and \"transactions\".\"card_id\" is null\n            when 'investment_out' then \"transactions\".\"account_id\" is not null and \"transactions\".\"card_id\" is null\n            when 'investment_in'  then \"transactions\".\"account_id\" is not null and \"transactions\".\"card_id\" is null\n            when 'transfer'       then \"transactions\".\"account_id\" is not null\n                                      and (\"transactions\".\"transfer_account_id\" is not null or \"transactions\".\"statement_id\" is not null)\n          end"
        }
      },
      "isRLSEnabled": false
    }
